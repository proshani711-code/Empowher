<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@android:color/white"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/imgWorkerProfile"
        android:layout_width="80dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_rounded"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWorkerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Worker Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/tvWorkerCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: Electrician"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray"/>

        <TextView
            android:id="@+id/tvWorkerCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="City: New York"
            android:textSize="14sp"
            android:textColor="@android:color/holo_blue_dark"/>

        <TextView
            android:id="@+id/tvWorkerExperience"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Experience: 5 years"
            android:textSize="14sp"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/tvWorkerRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating: 4.5⭐"
            android:textSize="14sp"
            android:textColor="#FFA000"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnEditWorker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:backgroundTint="@android:color/holo_orange_light"
            android:textColor="@android:color/white"
            android:layout_marginBottom="5dp"
            android:padding="8dp"/>

        <Button
            android:id="@+id/btnDeleteWorker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:backgroundTint="@android:color/holo_red_light"
            android:textColor="@android:color/white"
            android:padding="8dp"/>
    </LinearLayout>
</LinearLayout>