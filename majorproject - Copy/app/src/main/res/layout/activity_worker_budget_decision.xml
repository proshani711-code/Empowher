<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical"
    android:background="@color/light_background">

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":User  Loading..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_blue_dark"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:id="@+id/tvAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:text="Address: Loading..."
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvProblemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Problem Description: Loading..."
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvIncludeMaterials"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Includes Materials"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_green_dark"
        android:layout_marginBottom="10dp"
        android:visibility="gone"/> <!-- Initially Hidden -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Your Proposed Budget"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etProposedBudget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter budget amount"
        android:background="@drawable/rounded_edittext"
        android:padding="12dp"
        android:inputType="numberDecimal"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etWorkerComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Additional comments (optional)"
        android:background="@drawable/rounded_edittext"
        android:padding="12dp"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:layout_marginTop="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnSubmitBudget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Submit Budget"
            android:background="@drawable/gradient_button"
            android:textColor="@android:color/white"
            android:padding="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:background="@drawable/rounded_edittext"
            android:textColor="@color/black"
            android:padding="10dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"/>
</LinearLayout>